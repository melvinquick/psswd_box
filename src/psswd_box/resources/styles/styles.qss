/* =========================================
   UNIVERSAL BASE (DO NOT EDIT PER APP)
   ========================================= */

QWidget {
    background-color: {{background-color}};
    color: {{color}};
    font-family: "{{font-family}}";
    font-size: {{font-size-base}};
}

QMainWindow, QDialog {
    background-color: {{background-color}};
}

QToolTip {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: {{padding-v}} {{padding-h}};
}

QLabel {
    background: transparent;
    color: {{color}};
}

QMenuBar {
    background-color: {{surface-color}};
    color: {{color}};
    border-bottom: {{border}};
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: {{border-radius}};
}

QMenuBar::item:selected {
    background-color: {{widget-background-color}};
}

QMenu {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: {{border-radius}};
}

QMenu::item:selected {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

QFrame#Card, QFrame#Section {
    background-color: {{surface-color}};
    border: {{border}};
    border-radius: {{border-radius}};
}

QLabel#DialogTitle {
    font-size: {{font-size-lg}};
    font-weight: 700;
    color: {{color}};
}

QLabel#MutedLabel {
    color: {{muted-color}};
    font-size: {{font-size-base}};
}

QPushButton {
    background-color: {{widget-background-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: {{padding-v}} {{padding-h}};
    min-height: 24px;
}

QPushButton:hover {
    border-color: {{accent-color}};
}

QPushButton:pressed {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

QPushButton#PrimaryButton {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
    border: 1px solid {{accent-color}};
    font-weight: 700;
    padding: 12px 16px;
    font-size: {{font-size-lg}};
}

QPushButton#PrimaryButton:hover {
    background-color: {{accent-hover-color}};
    border-color: {{accent-hover-color}};
}

QLineEdit, QComboBox {
    background-color: {{widget-background-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: {{padding-v}} {{padding-h}};
    selection-background-color: {{accent-color}};
    selection-color: {{accent-text-color}};
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid {{accent-color}};
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    selection-background-color: {{accent-color}};
    selection-color: {{accent-text-color}};
    outline: none;
}

QCheckBox {
    color: {{color}};
    spacing: 8px;
    background: transparent;
    padding: 4px 0px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: {{border}};
    border-radius: 3px;
    background-color: {{widget-background-color}};
}

QCheckBox::indicator:checked {
    background-color: {{accent-color}};
    border-color: {{accent-color}};
    image: url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSJ3aGl0ZSIgc3Ryb2tlLXdpZHRoPSIzIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiPjxwb2x5bGluZSBwb2ludHM9IjIwIDYgOSAxNyA0IDEyIj48L3BvbHlsaW5lPjwvc3ZnPg==);
}

/* =========================================
   PSSWD BOX SPECIFIC EXTENSIONS
   ========================================= */

QSlider::groove:horizontal {
    height: 6px;
    background: {{widget-background-color}};
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: {{accent-color}};
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
    background: {{accent-color}};
}

QProgressBar {
    background-color: {{widget-background-color}};
    border: none;
    border-radius: 4px;
    max-height: 8px;
}

QProgressBar::chunk {
    background-color: {{accent-color}};
    border-radius: 4px;
}

#PasswordInput {
    background-color: {{widget-background-color}};
    border: {{border}};
    border-radius: {{border-radius}};
}

#PasswordInput QLineEdit#PasswordEdit {
    background: transparent;
    border: none;
    min-height: 36px;
    padding: 4px 8px;
    font-family: monospace;
    font-size: 18px;
}

#PasswordInput QLineEdit#PasswordEdit:focus {
    border: none;
}

QPushButton#IconButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0;
}

QPushButton#IconButton:hover {
    background-color: {{surface-color}};
}

QPushButton#MenuButton {
    background: transparent;
    color: {{color}};
    border: none;
    padding: 6px 12px;
    margin: 0px;
    border-radius: 4px;
}

QPushButton#MenuButton:hover {
    background: {{widget-background-color}};
}

QPushButton#MenuButton:pressed {
    background: {{accent-color}};
}

/* =========================================
   PSSWD BOX MENU BAR FIXES
   ========================================= */

QWidget#TopBarContainer {
    background-color: {{surface-color}};
    border-bottom: {{border}};
}

QWidget#TopBarContainer QMenuBar {
    background-color: transparent;
    border: none;
    padding: 0px;
}

QWidget#TopBarContainer QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: {{border-radius}};
    color: {{color}};
}

QWidget#TopBarContainer QMenuBar::item:selected {
    background-color: {{widget-background-color}};
}

QWidget#TopBarContainer QMenuBar::item:pressed {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

/* =========================================
   PSSWD BOX MENU ALIGNMENT FIXES
   ========================================= */

QWidget#TopBarContainer QMenuBar {
    background-color: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}

QWidget#TopBarContainer QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    margin: 0px;
}

QWidget#TopBarContainer QPushButton#MenuButton {
    background: transparent;
    color: {{color}};
    border: none;
    padding: 6px 12px;
    margin: 0px;
    min-height: 0px;
    text-align: center;
}

QWidget#TopBarContainer QPushButton#MenuButton:hover {
    background-color: {{widget-background-color}};
    border-radius: {{border-radius}};
}

QWidget#TopBarContainer QPushButton#MenuButton:pressed {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

/* =========================================
   PSSWD BOX MENU FONT ALIGNMENT FIXES
   ========================================= */

QWidget#TopBarContainer QMenuBar {
    background-color: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
    font-size: {{font-size-base}};
}

QWidget#TopBarContainer QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    margin: 0px;
    min-height: 0px;
    font-size: {{font-size-base}};
}

QWidget#TopBarContainer QPushButton#MenuButton {
    background: transparent;
    color: {{color}};
    border: none;
    padding: 6px 12px;
    margin: 0px;
    min-height: 0px;
    font-size: {{font-size-base}};
}

QWidget#TopBarContainer QPushButton#MenuButton:hover {
    background-color: {{widget-background-color}};
    border-radius: {{border-radius}};
}

QWidget#TopBarContainer QPushButton#MenuButton:pressed {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}