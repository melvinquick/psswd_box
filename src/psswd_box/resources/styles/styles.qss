/* ============================================================
   Psswd Box — Global stylesheet
   ============================================================ */

/* ---------- Base ---------- */
#MainWindow, #CentralWidget {
    background-color: {{background-color}};
}

QLabel {
    color: {{color}};
    background: transparent;
    border: none;
    font-size: {{font-size}};
}

QToolTip {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: 6px 10px;
}

/* ---------- Custom Menu Bar ---------- */
#TopBarContainer {
    background-color: {{surface-color}};
    border-bottom: {{border}};
}

QMenuBar {
    background-color: transparent;
    color: {{color}};
    font-size: 13px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: {{widget-background-color}};
}

QMenu {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
}

QMenu::item {
    padding: 6px 24px;
}

QMenu::item:selected {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

/* The direct Preferences button, styled exactly like a menu item */
QPushButton#MenuButton {
    background: transparent;
    color: {{color}};
    border: none;
    padding: 6px 12px;
    margin: 0px;
    border-radius: 4px;
    font-size: 13px;
}

QPushButton#MenuButton:hover {
    background: {{widget-background-color}};
}

QPushButton#MenuButton:pressed {
    background: {{accent-color}};
}

/* ---------- Sections ---------- */
#Section {
    background-color: {{surface-color}};
    border: {{border}};
    border-radius: {{border-radius}};
}

#SectionTitle {
    font-size: 15px;
    font-weight: 700;
    color: {{color}};
    padding-bottom: 8px;
    border-bottom: {{border}};
}

#MutedLabel {
    color: {{muted-color}};
}

/* ---------- Status label ---------- */
#StatusLabel { color: {{color}}; }
#StatusLabel[kind="info"]    { color: {{color}}; }
#StatusLabel[kind="success"] { color: {{accent-color}}; }
#StatusLabel[kind="warning"] { color: {{warning-color}}; }
#StatusLabel[kind="danger"]  { color: {{danger-color}}; }

/* ---------- Checkboxes ---------- */
QCheckBox {
    color: {{color}};
    spacing: 8px;
    background: transparent;
    padding: 8px 0px;
    font-size: 15px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: {{border}};
    background-color: {{widget-background-color}};
}

QCheckBox::indicator:hover {
    border-color: {{muted-color}};
}

QCheckBox::indicator:checked {
    background-color: {{accent-color}};
    border-color: {{accent-color}};
}

/* ---------- Standard Inputs ---------- */
QLineEdit, QSpinBox, QComboBox {
    background-color: {{widget-background-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: {{padding}};
    font-size: {{font-size}};
    selection-background-color: {{accent-color}};
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid {{muted-color}};
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
    selection-background-color: {{accent-color}};
}

QSpinBox {
    padding-right: 34px;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: transparent;
    width: 32px;
    border: none;
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    border-left: {{border}};
    border-bottom: {{border}};
    border-top-right-radius: {{border-radius}};
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border-left: {{border}};
    border-bottom-right-radius: {{border-radius}};
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: {{widget-background-color}};
}
QSpinBox::up-arrow, QSpinBox::down-arrow {
    width: 12px;
    height: 12px;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: {{widget-background-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: {{padding}};
    font-size: {{font-size}};
}

QPushButton:hover {
    border-color: {{muted-color}};
}

QPushButton:pressed {
    background-color: {{surface-color}};
}

QPushButton#PrimaryButton {
    font-weight: 700;
    padding: 12px 16px;
    font-size: 15px;
}

/* ---------- Slider ---------- */
QSlider::groove:horizontal {
    height: 6px;
    background: {{widget-background-color}};
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: {{accent-color}};
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
    background: {{accent-color}};
}

QSlider::handle:horizontal:hover {
    background: {{accent-hover-color}};
}

/* ---------- Progress bar (strength) ---------- */
QProgressBar {
    background-color: {{widget-background-color}};
    border: none;
    border-radius: 4px;
    max-height: 8px;
}

QProgressBar::chunk {
    background-color: {{accent-color}};
    border-radius: 4px;
}

/* Removed the [level] rules */

/* ---------- Custom Password Input ---------- */
#PasswordInput {
    background-color: {{widget-background-color}};
    border: {{border}};
    border-radius: {{border-radius}};
}

#PasswordInput QLineEdit#PasswordEdit {
    background: transparent;
    border: none;
    min-height: 36px;
    padding: 4px 8px;
    font-family: monospace;
    font-size: 18px;
}

#PasswordInput QLineEdit#PasswordEdit:focus {
    border: none;
}

QPushButton#IconButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0;
}

QPushButton#IconButton:hover {
    background-color: {{surface-color}};
}

/* ---------- Dialog Overrides ---------- */
#DialogTitle {
    font-size: 24px;
    font-weight: bold;
    color: {{color}};
}